{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/222438/marketing-experiment-01/blob/main/experiments/experiment-2-consumer-insight/schema/consumer-insight.schema.json",
  "title": "Consumer Insight Record",
  "description": "Evidence-grounded coding for one consumer review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "sentiment", "need", "pain_point", "scenario", "purchase_barrier", "evidence", "confidence"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "sentiment": {"enum": ["positive", "negative", "mixed", "neutral", "unknown"]},
    "need": {"$ref": "#/$defs/needLabels"},
    "pain_point": {"$ref": "#/$defs/painPointLabels"},
    "scenario": {"$ref": "#/$defs/scenarioLabels"},
    "purchase_barrier": {"$ref": "#/$defs/purchaseBarrierLabels"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "quote"],
        "properties": {
          "field": {"enum": ["sentiment", "need", "pain_point", "scenario", "purchase_barrier"]},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]}
  },
  "$defs": {
    "needLabels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["quality", "value", "convenience", "service", "information", "fit", "durability", "safety", "none", "unknown"]}
    },
    "painPointLabels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["price", "quality", "taste", "delivery", "packaging", "service", "usability", "fit", "availability", "none", "unknown"]}
    },
    "scenarioLabels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["home", "commute", "work", "travel", "gift", "outdoor", "exercise", "family", "unknown"]}
    },
    "purchaseBarrierLabels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["price", "trust", "quality", "availability", "delivery", "fit", "complexity", "none", "unknown"]}
    }
  }
}
